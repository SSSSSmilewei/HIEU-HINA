# 复制成 .env 再改（scripts/setup.sh 会自动复制）。.env 里有密码，不要提交。

# 大家在浏览器里打开的地址。本机试装用 localhost；
# 放到学校服务器上以后改成它的地址或域名，比如 https://git.example.edu.cn/
ROOT_URL=http://localhost:3300/
# 3000 常被开发服务器占用，这里用 3300
HTTP_PORT=3300
SSH_DOMAIN=localhost
SSH_PORT=2222

# 第一个管理员（setup.sh 用它建组织和团队）
ADMIN_USER=hiana-admin
ADMIN_EMAIL=admin@hiana.local
# 留空的话 setup.sh 会随机生成一个，写回这个文件
ADMIN_PASSWORD=v9uSCepMfJcUHGxDVEIS

# 协会的组织名（只能用英文字母、数字、- _ .）
ORG=hiana

# 运行器和服务器之间的共享密钥（40 位十六进制），留空则自动生成
RUNNER_SECRET=6284ad5e9a5ea522443012ab296e63ea3c0865aa
